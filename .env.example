# ---- Runtime ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/hostel_management

# ---- Auth ----
# Use a long random string, unique per environment. NEVER commit a real secret.
SESSION_SECRET=replace_with_a_long_random_secret
# Session cookie lifetime in hours
SESSION_TTL_HOURS=8

# ---- App behaviour ----
# Allow open student self-registration (true/false). Staff accounts are always admin-created.
ALLOW_SELF_REGISTRATION=true
# Allow the seed script to create demo accounts with known dev-only passwords (true/false)
SEED_DEMO_USERS=true
# Hours after resolution during which a student may reopen a complaint
COMPLAINT_REOPEN_WINDOW_HOURS=48

# ---- Chatbot ----
# "local" = built-in FAQ/rule-based assistant (no external service, works offline).
# Optional AI upgrade: set CHAT_PROVIDER=openai-compatible and supply a server-side key.
# The key stays on the server; the browser never sees it. Without a key the app
# automatically falls back to the local assistant.
CHAT_PROVIDER=local
CHAT_PROVIDER_API_KEY=
CHAT_PROVIDER_BASE_URL=
CHAT_PROVIDER_MODEL=

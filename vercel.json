{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/student", "destination": "/student/dashboard", "permanent": false },
    { "source": "/student/", "destination": "/student/dashboard", "permanent": false },
    { "source": "/warden", "destination": "/warden/dashboard", "permanent": false },
    { "source": "/warden/", "destination": "/warden/dashboard", "permanent": false },
    { "source": "/admin", "destination": "/admin/dashboard", "permanent": false },
    { "source": "/admin/", "destination": "/admin/dashboard", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
